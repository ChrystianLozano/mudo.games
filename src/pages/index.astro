---
import "../styles/global.css";
import { XMLParser } from "fast-xml-parser";

const channelId = import.meta.env.YOUTUBE_CHANNEL_ID;
const channelName = import.meta.env.YOUTUBE_CHANNEL_NAME ?? "mudo.games";
const siteUrl = import.meta.env.SITE ?? "https://mudo.games";
const pageTitle = `Últimos videos de ${channelName}`;
const pageDescription =
  "Explora los últimos videos, shorts y destacados de mudo.games con miniaturas, timeline y reproducción directa. Contacto: hola@mudo.games.";

if (!channelId) {
  throw new Error("Falta YOUTUBE_CHANNEL_ID en el entorno (.env)");
}

const playlistId = import.meta.env.YOUTUBE_PLAYLIST_ID ?? "PLqruPmqTbIPMyUyh_MS9FCc9lmvAGd1VA";
const arcPlaylistId = "PLqruPmqTbIPOqkBTOa6rN15-kH0TufGP3";

const feedUrl = `https://www.youtube.com/feeds/videos.xml?channel_id=${channelId}&t=${Date.now()}`;
const playlistFeedUrl = `https://www.youtube.com/feeds/videos.xml?playlist_id=${playlistId}&t=${Date.now()}`;
const arcPlaylistFeedUrl = `https://www.youtube.com/feeds/videos.xml?playlist_id=${arcPlaylistId}&t=${Date.now()}`;

let videos = [];
let playlistVideos = [];
let playlistTitle = "Serie Especial";
let arcVideos = [];
let arcPlaylistTitle = "Arc Raiders";
let spotlight = [];
let shorts = [];
let latest = null;
let fetchError = "";
let playlistError = "";
let arcPlaylistError = "";

const parser = new XMLParser({
  ignoreAttributes: false,
  attributeNamePrefix: "",
  removeNSPrefix: true,
});

function parseFeed(xml) {
  const data = parser.parse(xml);
  const title = data?.feed?.title ?? "";
  const entries = data?.feed?.entry ?? [];
  const items = Array.isArray(entries) ? entries : [entries];

  const parsedVideos = items.map((entry) => {
    const id = entry.videoId;
    const title = entry.title ?? "Video";
    const published = entry.published ?? "";
    const description = entry?.group?.description ?? entry?.summary ?? "";

    const link = Array.isArray(entry.link)
      ? entry.link.find((l) => l.rel === "alternate")?.href
      : entry.link?.href;

    const thumbFromFeed = entry?.group?.thumbnail?.url;
    const thumbnail =
      thumbFromFeed ?? (id ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : "");

    const lowerTitle = title.toLowerCase();
    const isShort =
      (typeof link === "string" && link.includes("/shorts/")) ||
      lowerTitle.includes("#shorts") ||
      lowerTitle.includes("short");

    return { id, title, published, link, thumbnail, isShort, description };
  });

  return { title, videos: parsedVideos };
}

const [channelRes, playlistRes, arcPlaylistRes] = await Promise.allSettled([
  fetch(feedUrl),
  fetch(playlistFeedUrl),
  fetch(arcPlaylistFeedUrl),
]);

if (channelRes.status === "fulfilled" && channelRes.value.ok) {
  try {
    const xml = await channelRes.value.text();
    const parsed = parseFeed(xml);
    videos = parsed.videos;
    latest = videos[0] ?? null;
    const nonShorts = videos.filter((video) => !video.isShort);
    const spotlightCandidates = latest && !latest.isShort
      ? nonShorts.filter((video) => video.id !== latest.id)
      : nonShorts;
    spotlight = spotlightCandidates.slice(0, 3);
    shorts = videos.filter((video) => video.isShort).slice(0, 4);
  } catch (err) {
    fetchError = err instanceof Error ? err.message : "Error al procesar canal";
  }
} else {
  fetchError = channelRes.status === "rejected" ? channelRes.reason?.message : `Respuesta ${channelRes.value?.status}`;
}

if (playlistRes.status === "fulfilled" && playlistRes.value.ok) {
  try {
    const xml = await playlistRes.value.text();
    const parsed = parseFeed(xml);
    playlistVideos = parsed.videos;
    if (parsed.title) {
      playlistTitle = parsed.title;
    }
  } catch (err) {
    playlistError = err instanceof Error ? err.message : "Error al procesar playlist";
  }
} else {
  playlistError = playlistRes.status === "rejected" ? playlistRes.reason?.message : `Respuesta ${playlistRes.value?.status}`;
}

if (arcPlaylistRes.status === "fulfilled" && arcPlaylistRes.value.ok) {
  try {
    const xml = await arcPlaylistRes.value.text();
    const parsed = parseFeed(xml);
    arcVideos = parsed.videos;
    if (parsed.title) {
      arcPlaylistTitle = parsed.title;
    }
  } catch (err) {
    arcPlaylistError = err instanceof Error ? err.message : "Error al procesar playlist de Arc Raiders";
  }
} else {
  arcPlaylistError = arcPlaylistRes.status === "rejected" ? arcPlaylistRes.reason?.message : `Respuesta ${arcPlaylistRes.value?.status}`;
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
