      sizes="152x152"
      href="/favicons/apple-touch-icon-152x152.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicons/apple-touch-icon-180x180.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/favicons/android-icon-192x192.png"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="msapplication-TileColor" content="#071a1c" />
    <meta name="theme-color" content="#071a1c" />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content={channelName} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="bg">
      <div class="glow"></div>
      <div class="orb orb-a"></div>
      <div class="orb orb-b"></div>
      <div class="lines"></div>
      <div class="grain"></div>
    </div>

    <header class="hero">
      <p class="eyebrow">Nuevos lanzamientos</p>
      <h1>
        Últimos videos de <span class="title-brand">mudo.games</span>
      </h1>
      <p class="sub">
        Gameplays más recientes. Destacado, spotlight, series especiales y una sección
        para Shorts.
        <span class="contact-line">Contacto: <a href="mailto:hola@mudo.games" class="contact-link">hola@mudo.games</a></span>
      </p>
      <div class="hero-actions">
        <a
          class="cta"
          href={`https://www.youtube.com/channel/${channelId}`}
          target="_blank"
          rel="noreferrer"
          id="hero-channel-cta"
        >
          Ver canal completo
        </a>
        <span class="hint"
          >Actualizado automáticamente desde el feed oficial</span
        >
      </div>
      <div class="stats">
        <div>
          <span class="stat-label">Videos cargados</span>
          <strong class="stat-value">{videos.length}</strong>
        </div>
        <div>
          <span class="stat-label">Última publicación</span>
          <strong class="stat-value">
            {
              latest?.published
                ? new Date(latest.published).toLocaleDateString("es-MX", {
                    weekday: "long",
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })
                : "—"
            }
          </strong>
        </div>
        <div>
          <span class="stat-label">Shorts detectados</span>
          <strong class="stat-value">{shorts.length}</strong>
        </div>
      </div>
    </header>

    <main>
      <div class="content">
        {
          fetchError && (
          <div class="error">
            <strong>No se pudo cargar el feed.</strong>
            <span>{fetchError}</span>
          </div>
        )
      }

      {
        latest && (
          <section class="feature">
            <div class="feature-copy">
              <p class="eyebrow">Destacado</p>
              <h2>{latest.title}</h2>
              <p class="meta">
                Publicado:{" "}
                {new Date(latest.published).toLocaleDateString("es-MX", {
                  weekday: "long",
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
              <div class="chips">
                <span>Nuevo</span>
                <span>Feed oficial</span>
                <span>Calidad HQ</span>
              </div>
              <button
                class="cta js-open-modal"
                type="button"
                data-id={latest.id}
                data-title={latest.title}
                data-description={latest.description}
                id={`featured-play-btn-${latest.id}`}
              >
                Ver estreno
              </button>
            </div>
            <button
              class="feature-media js-open-modal"
              type="button"
              data-id={latest.id}
              data-title={latest.title}
              data-description={latest.description}
              aria-label={`Reproducir ${latest.title}`}
              id={`featured-media-btn-${latest.id}`}
            >
              {latest.thumbnail ? (
                <img
                  src={latest.thumbnail}
                  alt={`Miniatura de ${latest.title}`}
                  loading="lazy"
                />
              ) : (
                <div class="thumb-fallback">Sin miniatura</div>
              )}
              <span class="play big">▶</span>
            </button>
          </section>
        )
      }

      </div>

      <section class="playlist-section is-spotlight">
        <div class="playlist-header">
          <div class="section-head">
            <span class="playlist-badge">Destacados</span>
            <h2 class="section-title playlist-title">Spotlight</h2>
            <p>Los tres lanzamientos más frescos listos para reproducirse.</p>
          </div>
          <div class="carousel-controls">
            <button class="carousel-btn prev-btn" aria-label="Videos anteriores" type="button">←</button>
            <button class="carousel-btn next-btn" aria-label="Videos siguientes" type="button">→</button>
          </div>
        </div>
        <div class="carousel-container">
          <div class="carousel-track">
            {
              spotlight.map((video) => (
                <article class="card playlist-card carousel-slide" key={video.id}>
                  <button
                    class="thumb js-open-modal"
                    type="button"
                    data-id={video.id}
                    data-title={video.title}
                    data-description={video.description}
                    aria-label={`Reproducir ${video.title}`}
                    id={`spotlight-thumb-${video.id}`}
                  >
                    {video.thumbnail ? (
                      <img
                        src={video.thumbnail}
                        alt={`Miniatura de ${video.title}`}
                        loading="lazy"
                      />
                    ) : (
                      <div class="thumb-fallback">Sin miniatura</div>
                    )}
                    <span class="play">▶</span>
                  </button>
                  <div class="card-body">
                    <h3>{video.title}</h3>
                    <p class="meta">
                      Publicado:{" "}
                      {video.published
                        ? new Date(video.published).toLocaleDateString("es-MX", {
                            weekday: "long",
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                          })
                        : ""}
                    </p>
                    <button
                      class="link js-open-modal"
                      type="button"
                      data-id={video.id}
                      data-title={video.title}
                      data-description={video.description}
                      id={`spotlight-link-${video.id}`}
                    >
                      Ver video
                    </button>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      {
        playlistVideos.length > 0 && (
          <section class="playlist-section is-fortnite">
            <div class="playlist-header">
              <div class="section-head">
                <span class="playlist-badge">Serie Especial</span>
                <h2 class="section-title playlist-title">{playlistTitle}</h2>
                <p>Explora gameplays destacados, las mejores partidas y novedades de la comunidad del Battle Royale de Epic Games.</p>
                <p class="playlist-support">Apóyame usando el código <strong>MUDO</strong> en la tienda <span>#EpicPartner</span></p>
              </div>
              <div class="carousel-controls">
                <button class="carousel-btn prev-btn" aria-label="Videos anteriores" type="button">←</button>
                <button class="carousel-btn next-btn" aria-label="Videos siguientes" type="button">→</button>
              </div>
            </div>
            <div class="carousel-container">
              <div class="carousel-track">
                {
                  playlistVideos.slice(0, 10).map((video) => (
                    <article class="card playlist-card carousel-slide" key={video.id}>
                      <button
                        class="thumb js-open-modal"
                        type="button"
                        data-id={video.id}
                        data-title={video.title}
                        data-description={video.description}
                        aria-label={`Reproducir ${video.title}`}
                        id={`playlist-thumb-${video.id}`}
                      >
                        {video.thumbnail ? (
                          <img
                            src={video.thumbnail}
                            alt={`Miniatura de ${video.title}`}
                            loading="lazy"
                          />
                        ) : (
                          <div class="thumb-fallback">Sin miniatura</div>
                        )}
                        <span class="play">▶</span>
                      </button>
                      <div class="card-body">
                        <h3>{video.title}</h3>
                        <p class="meta">
                          Publicado:{" "}
                          {video.published
                            ? new Date(video.published).toLocaleDateString("es-MX", {
                                weekday: "long",
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                              })
                            : ""}
                        </p>
                        <button
                          class="link js-open-modal"
                          type="button"
                          data-id={video.id}
                          data-title={video.title}
                          data-description={video.description}
                          id={`playlist-link-${video.id}`}
                        >
                          Ver video
                        </button>
                      </div>
                    </article>
                  ))
                }
              </div>
            </div>
          </section>
        )
      }

      {
        arcVideos.length > 0 && (
          <section class="playlist-section is-arc">
            <div class="playlist-header">
              <div class="section-head">
                <span class="playlist-badge">Serie Especial</span>
                <h2 class="section-title playlist-title">{arcPlaylistTitle}</h2>
                <p>Explora la cobertura de Arc Raiders, el shooter de extracción en tercera persona.</p>
              </div>
              <div class="carousel-controls">
                <button class="carousel-btn prev-btn" aria-label="Videos anteriores" type="button">←</button>
                <button class="carousel-btn next-btn" aria-label="Videos siguientes" type="button">→</button>
              </div>
            </div>
            <div class="carousel-container">
              <div class="carousel-track">
                {
                  arcVideos.slice(0, 10).map((video) => (
                    <article class="card playlist-card carousel-slide" key={video.id}>
                      <button
                        class="thumb js-open-modal"
                        type="button"
                        data-id={video.id}
                        data-title={video.title}
                        data-description={video.description}
                        aria-label={`Reproducir ${video.title}`}
                        id={`arc-thumb-${video.id}`}
                      >
                        {video.thumbnail ? (
                          <img
                            src={video.thumbnail}
                            alt={`Miniatura de ${video.title}`}
                            loading="lazy"
                          />
                        ) : (
                          <div class="thumb-fallback">Sin miniatura</div>
                        )}
                        <span class="play">▶</span>
                      </button>
                      <div class="card-body">
                        <h3>{video.title}</h3>
                        <p class="meta">
                          Publicado:{" "}
                          {video.published
                            ? new Date(video.published).toLocaleDateString("es-MX", {
                                weekday: "long",
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                              })
                            : ""}
                        </p>
                        <button
                          class="link js-open-modal"
                          type="button"
                          data-id={video.id}
                          data-title={video.title}
                          data-description={video.description}
                          id={`arc-link-${video.id}`}
                        >
                          Ver video
                        </button>
                      </div>
                    </article>
                  ))
                }
              </div>
            </div>
          </section>
        )
      }

      <div class="content">
        <section class="shorts">
        <div class="section-head">
          <h2 class="section-title">Shorts</h2>
          <p>Clips rápidos detectados por el feed.</p>
        </div>
        <div class={`shorts-row ${shorts.length <= 2 ? "few-shorts" : ""}`}>
          {
            shorts.length > 0 ? (
              shorts.map((video) => (
                <button
                  class="short-card js-open-modal"
                  key={video.id}
                  type="button"
                  data-id={video.id}
                  data-title={video.title}
                  data-description={video.description}
                  aria-label={`Reproducir ${video.title}`}
                  id={`short-card-${video.id}`}
                >
                  {video.thumbnail ? (
                    <img
                      src={video.thumbnail}
                      alt={`Miniatura de ${video.title}`}
                      loading="lazy"
                    />
                  ) : (
                    <div class="thumb-fallback">Sin miniatura</div>
                  )}
                  <div class="short-info">
                    <span>Short</span>
                    <h3>{video.title}</h3>
                  </div>
                </button>
              ))
            ) : (
              <div class="empty">
                No se detectaron Shorts en los últimos videos.
              </div>
            )
          }
        </div>
      </section>

      <section class="all-videos">
        <div class="section-head">
          <h2 class="section-title">Todos los últimos {videos.length}</h2>
          <p>La lista completa del feed, lista para maratonear.</p>
        </div>
        <div class="grid">
          {
            videos.map((video) => (
              <article class="card" key={video.id}>
                <button
                  class="thumb js-open-modal"
                  type="button"
                  data-id={video.id}
                  data-title={video.title}
                  data-description={video.description}
                  aria-label={`Reproducir ${video.title}`}
                  id={`all-videos-thumb-${video.id}`}
                >
                  {video.thumbnail ? (
                    <img
                      src={video.thumbnail}
                      alt={`Miniatura de ${video.title}`}
                      loading="lazy"
                    />
                  ) : (
                    <div class="thumb-fallback">Sin miniatura</div>
                  )}
                  <span class="play">▶</span>
                </button>
                <div class="card-body">
                  <h3>{video.title}</h3>
                  <p class="meta">
                    Publicado:{" "}
                    {video.published
                      ? new Date(video.published).toLocaleDateString("es-MX", {
                          weekday: "long",
                          year: "numeric",
                          month: "long",
                          day: "numeric",
                        })
                      : ""}
                  </p>
                  <button
                    class="link js-open-modal"
                    type="button"
                    data-id={video.id}
                    data-title={video.title}
                    data-description={video.description}
                    id={`all-videos-link-${video.id}`}
                  >
                    Ver video
                  </button>
                </div>
              </article>
            ))
          }
        </div>
      </section>
      </div>
    </main>

    <div class="modal" id="video-modal" aria-hidden="true">
      <div class="modal-backdrop" data-close="true"></div>
      <div
        class="modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-title"
      >
        <button
          class="modal-close"
          type="button"
          aria-label="Cerrar"
          data-close="true"
          id="modal-close-btn"
        >
          ✕
        </button>
        <div class="modal-media">
          <iframe
            id="modal-iframe"
            title="Reproductor de YouTube"
            src=""
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen></iframe>
        </div>
        <div class="modal-info">
          <p class="eyebrow">Reproduciendo</p>
          <h3 id="modal-title">Reproductor de video</h3>
          <p id="modal-description" class="modal-desc"></p>
          <a
            id="modal-link"
            class="cta modal-cta"
            href="https://www.youtube.com"
            target="_blank"
            rel="noreferrer"
          >
            Ver en YouTube
          </a>
        </div>
      </div>
    </div>

    <footer class="footer">
      <p class="footer-credit">
        Hecho con Astro + YouTube RSS - desarrollado por <a
          href="https://chrystian.dev">Chrystian Fabian Lozano Ramirez</a
        >
      </p>
      <div class="social-wrap" aria-label="Redes sociales de mudo">
        <span class="social-title">Sígueme en</span>
        <div class="social-links">
          <a href="https://tiktok.com/@mudo_" target="_blank" rel="noreferrer" id="social-link-tiktok">
            <svg
              class="social-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                fill="currentColor"
                d="M15.8 4c.2 1.3.9 2.4 1.9 3.2 1 .8 2.2 1.3 3.5 1.4v3.3c-1.7-.1-3.4-.6-4.9-1.5v5.8c0 1.5-.6 2.9-1.7 3.9a6 6 0 0 1-4.1 1.6 6 6 0 0 1-4.1-1.6 5.3 5.3 0 0 1-1.7-3.9c0-1.5.6-2.9 1.7-3.9a6 6 0 0 1 4.1-1.6c.3 0 .6 0 .9.1v3.2a2.4 2.4 0 0 0-.9-.2c-.7 0-1.2.2-1.7.7a2.2 2.2 0 0 0 0 3.3c.5.4 1 .7 1.7.7.6 0 1.2-.3 1.7-.7.4-.4.7-1 .7-1.7V4h3.2Z"
              ></path>
            </svg>
            TikTok
          </a>
          <a href="https://twitter.com/mudo_" target="_blank" rel="noreferrer" id="social-link-twitter">
            <svg
              class="social-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                fill="currentColor"
                d="m18.9 3h3.4l-7.4 8.4L23.6 21h-6.8L11.5 14.7 6 21H2.6l7.9-9L2 3h7l4.8 5.8L18.9 3Zm-1.2 16h1.9L7.9 4.9H5.8L17.7 19Z"
              ></path>
            </svg>
            Twitter
          </a>
          <a
            href="https://instagram.com/mudo_"
            target="_blank"
            rel="noreferrer"
            id="social-link-instagram"
          >
            <svg
              class="social-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                fill="currentColor"
                d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9Zm10.3 1.5a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"
              ></path>
